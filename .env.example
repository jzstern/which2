# Secrets are managed via Doppler (https://doppler.com)
# Run: doppler setup --project which2 --config dev
# Then: bun dev (scripts auto-inject via doppler run)
#
# Only use .env.local as a fallback if Doppler is not configured:
GEMINI_API_KEY=your-gemini-api-key-here
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
